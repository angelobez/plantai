  "info": {
    "title": "PlantAí API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "description": "Stable error code; the app shows the message"
          },
          "errors": {
            "description": "Per-field details, only for VALIDATION_FAILED",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Neighbors see only the first name in the listings"
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "The 6-digit code from the e-mail"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "AuthTokens_Output": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT for `Authorization: Bearer`; lasts 15 minutes"
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque; renews the session at POST /auth/refresh for 30 days"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string",
                "example": "+5511987654321",
                "description": "WhatsApp number (E.164); null until the first listing",
                "nullable": true
              },
              "donationLocation": {
                "type": "object",
                "properties": {
                  "neighborhood": {
                    "type": "string"
                  }
                },
                "required": [
                  "neighborhood"
                ],
                "additionalProperties": false,
                "description": "Null until the first listing; the coordinates never come back",
                "nullable": true
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "phone",
              "donationLocation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "HealthResponse_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "apiVersion": {
            "type": "string",
            "description": "Version of the API package"
          },
          "postgisVersion": {
            "type": "string",
            "description": "Read from the database itself"
          }
        },
        "required": [
          "status",
          "apiVersion",
          "postgisVersion"
        ],
        "additionalProperties": false
      },
      "UserProfile_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "example": "+5511987654321",
            "description": "WhatsApp number (E.164); null until the first listing",
            "nullable": true
          },
          "donationLocation": {
            "type": "object",
            "properties": {
              "neighborhood": {
                "type": "string"
              }
            },
            "required": [
              "neighborhood"
            ],
            "additionalProperties": false,
            "description": "Null until the first listing; the coordinates never come back",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "donationLocation"
        ],
        "additionalProperties": false
      }
    }
  }
}
