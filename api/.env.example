# Copy to .env (never committed) and fill in. The API refuses to start if any
# required variable is missing or invalid.

# Matches compose.yaml (`npm run db:up`).
DATABASE_URL=postgres://plantai:plantai@localhost:5432/plantai
PORT=3000
# Oldest app version (X-App-Version) the API is meant to accept.
MIN_APP_VERSION=0.0.0
# Optional for now; https://my.plantnet.org/
# PLANTNET_API_KEY=
