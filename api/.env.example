# Copy to .env (never committed) and fill in. The API refuses to start if any
# required variable is missing or invalid.

# Matches compose.yaml (`npm run db:up`).
DATABASE_URL=postgres://plantai:plantai@localhost:5432/plantai
PORT=3000
# Oldest app version (X-App-Version) the API is meant to accept.
MIN_APP_VERSION=0.0.0
# Optional for now; https://my.plantnet.org/
# PLANTNET_API_KEY=

# Signs the access tokens; at least 32 characters. Generate one with
# `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
# ID of the OAuth Web client in Google Cloud (the audience of Google ID tokens).
GOOGLE_WEB_CLIENT_ID=replace-me.apps.googleusercontent.com
# Without a key, e-mails (sign-up codes, for instance) are written to the API
# log. With one, they go through Resend; onboarding@resend.dev only delivers to
# the Resend account's own e-mail (test mode). https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=PlantAí <onboarding@resend.dev>
