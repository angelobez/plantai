# Copy to .env (never committed) and fill in. The API refuses to start if any
# required variable is missing or invalid.

# Matches compose.yaml (`npm run db:up`).
DATABASE_URL=postgres://plantai:plantai@localhost:5432/plantai
PORT=3000
# Oldest app version (X-App-Version) the API is meant to accept.
MIN_APP_VERSION=0.0.0
# Optional for now; https://my.plantnet.org/
# PLANTNET_API_KEY=

# Signs the access tokens; at least 32 characters. Generate one with
# `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
# ID of the OAuth Web client in Google Cloud (the audience of Google ID tokens).
# Public, not a secret: this is the PlantAí project's Web client (plantai-513101).
GOOGLE_WEB_CLIENT_ID=431388587561-jhgntmp6i18htkblrnopm61b0h3815ld.apps.googleusercontent.com
# Without a key, e-mails (sign-up codes, for instance) are written to the API
# log. With one, they go through Resend; onboarding@resend.dev only delivers to
# the Resend account's own e-mail (test mode). https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=PlantAí <onboarding@resend.dev>

# Photo storage (S3). Locally, the S3 emulator from compose.yaml (RustFS, with
# the bucket created by `npm run db:up`); the endpoint and keys match it. In
# AWS (phase 2), leave S3_ENDPOINT and the keys empty: the SDK talks to S3 and
# the Lambda role gives the credentials.
S3_BUCKET=plantai-photos
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=plantai
S3_SECRET_ACCESS_KEY=plantai-local-secret

# Claude writes the care guides, in the API (first opening of a species) and in
# `npm run catalog:load`. https://platform.claude.com/settings/keys
# Tests never use it: the care-guide writer is a fake there.
ANTHROPIC_API_KEY=
# Optional; the model that writes the care guides (default claude-sonnet-5-5).
# CARE_GUIDE_MODEL=
